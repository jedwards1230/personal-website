{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Edit",
			"Write",
			"Bash(bun install:*)",
			"Bash(bun run:*)",
			"Bash(bunx:*)",
			"Bash(npx playwright:*)",
			"Bash(git add:*)",
			"Bash(git commit:*)",
			"Bash(git push:*)",
			"Bash(git log:*)",
			"Bash(git diff:*)",
			"Bash(git status:*)",
			"Bash(git checkout:*)",
			"Bash(git branch:*)",
			"Bash(gh pr create:*)",
			"Bash(gh pr view:*)",
			"Bash(gh pr list:*)",
			"Bash(gh pr checks:*)",
			"Bash(gh run view:*)",
			"Bash(ls:*)",
			"Bash(grep:*)",
			"Bash(rg:*)",
			"Bash(curl:*)",
			"Bash(tree:*)",
			"Bash(wc:*)",
			"WebFetch",
			"WebSearch",
			"Skill"
		]
	},
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
					}
				]
			}
		]
	},
	"enabledPlugins": {
		"screenshotter@jedwards1230-plugins": true
	},
	"extraKnownMarketplaces": {
		"jedwards1230-plugins": {
			"source": {
				"source": "github",
				"repo": "jedwards1230/claude-plugins"
			}
		}
	}
}
